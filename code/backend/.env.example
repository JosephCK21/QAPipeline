# Existing backend settings
PORT=3001
GITHUB_TOKEN=

# Per-project environment variables injected into PR sandbox Docker containers (npm dev server,
# Jest, Playwright, pytest) are stored under data/sandbox-env/ and edited in Project Settings
# (or via GET/PUT /api/projects/:projectId/sandbox-env). They are not configured in this file.
# Keys must look like shell identifiers; AUTOQA_* is reserved and rejected for project sandbox env.

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Reasoning effort tiers per call purpose (low | medium | high)
OPENAI_SCENARIO_EFFORT=low
# Test-case generation: benchmark "low" vs "medium" on your repos — "low" often
# suffices for structured codegen and reduces latency/cost; raise if quality drops.
OPENAI_TESTCASE_EFFORT=medium
OPENAI_HEAL_EFFORT=medium
# Max output tokens for test-case generation (controls script length / cost / latency).
OPENAI_MAX_OUTPUT_TOKENS=16000
# Max output tokens for heal/repair calls (patches are typically short).
OPENAI_HEAL_MAX_OUTPUT_TOKENS=8000
# Stateful chain mechanism:
#   conversation (default) — Conversations API, no TTL, one conversation per test case
#   chain                  — previous_response_id chaining (items expire in 30 days)
#   zdr                    — no server-side storage; reasoning passed as encrypted_content each turn
OPENAI_STATEFUL_MODE=conversation
# Reasoning summary verbosity: auto | concise | detailed | none
OPENAI_REASONING_SUMMARY=auto
# Reasoning effort for the lightweight PR bug-fix classifier (none|low|medium|high|xhigh).
# "low" is the fastest universally-supported setting across gpt-5.x models.
OPENAI_CLASSIFIER_EFFORT=low
# Output verbosity hint for structured-output calls (low|medium|high). "low"
# trims ambient prose around JSON payloads; safe for all our strict-schema calls.
OPENAI_OUTPUT_VERBOSITY=low
# Prompt cache retention policy. "24h" keeps cached prefixes alive up to 24 hours
# (on gpt-5.x / gpt-5.x-mini), dramatically improving hit rate for long-running
# pipelines that span hours. Set to "in_memory" for the default 5-10 minute policy.
OPENAI_PROMPT_CACHE_RETENTION=24h

# LLM orchestration (PR test-case generation)
# Cap concurrent generateTestCasesForScenario calls per run — avoids cache-routing
# dilution when many scenarios share the same instruction prefix (see OpenAI prompt caching).
AUTOQA_LLM_MAX_CONCURRENT_GENERATION=4
# Prior scenarios passed as "already covered" hints (sliding window). 0 disables.
AUTOQA_LLM_ALREADY_GENERATED_MAX_ENTRIES=12

# PR ingest: git-first checkout + diff (default). Set to 1/true/yes for legacy REST listFiles + raw per-file fetches.
# AUTOQA_PR_USE_REST_FILES=

# Clone/fetch for PR workspace (same-repo shallow + deepen loop)
AUTOQA_PR_GIT_FETCH_DEPTH=120
AUTOQA_PR_GIT_CMD_TIMEOUT_MS=600000
AUTOQA_PR_GIT_MAX_DEEPEN=8
AUTOQA_PR_GIT_DEEPEN_BY=150

# Sandbox clones: reuse PR workspace objects via --reference-if-available (dissociated). Set to 0 to disable.
AUTOQA_SANDBOX_GIT_REFERENCE=1

# Bug-fix regression mode
# When REGRESSION_ENABLED=true (default) the pipeline runs a bug-fix classifier
# on every PR. If the PR is classified as a bug fix (LLM verdict above the
# confidence threshold OR a linked Jira issue with issueType=Bug), the pipeline
# skips new test-case generation and instead re-runs every existing latest
# test case for every scenario under every epic the PR touches. Failures are
# still healed but any heal marks the test case as "adapted" so the original
# failure is retained as a potential regression signal.
REGRESSION_ENABLED=true
REGRESSION_BUGFIX_CONFIDENCE_THRESHOLD=0.6

# Jira integration settings (Part 1)
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_USER_EMAIL=your@email.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_PROJECT_KEY=TEST
JIRA_TRIGGER_STATUS=Selected For Development
JIRA_WEBHOOK_SECRET=your_jira_webhook_secret_token_here
# Per-command cap for git clone and `docker exec` (npm install inside the container, tests). Increase if pipelines time out mid-run.
# Values like 30000 often kill Jest mid-run in Docker; 120000+ is safer.
SANDBOX_TIMEOUT_MS=120000
# Timeout (ms) for the initial `docker run` only. On first run Docker pulls Playwright (~multi-GB); if this is <= SANDBOX_TIMEOUT_MS
# and SANDBOX_TIMEOUT_MS is small, Node kills the pull with SIGTERM mid-stream (misleading container startup failures).
SANDBOX_DOCKER_PULL_TIMEOUT_MS=1200000
# Cap concurrent sandbox directory + Docker creates for this backend process (integer ≥ 1).
SANDBOX_MAX_CONCURRENT=3

# Host-only: optional subdirectory of the cloned repo whose package.json is the real web app
# (Next / Vite / react-scripts, with scripts.dev or scripts.start). When unset, the backend
# scans the clone (max depth 6, skipping node_modules/.git/.next/dist/build, etc.), picks the
# shallowest match, and writes .autoqa-app-root for the pool lifetime. If set, the path must
# still pass the same checks; otherwise a warning is logged and scanning is used. Example:
# AUTOQA_APP_SUBPATH=sayarat-web

# Regression classifier blend: when >0, linked Jira Bug issues still run the LLM and merge scores (see prClassificationService).
REGRESSION_CLASSIFIER_JIRA_LLM_BLEND=0

# Optional SQLite path for tests / multi-instance installs.
AUTOQA_DB_PATH=

# Playwright E2E in Docker: failure screenshots copied to the AutoQA UI per test case.
# AUTOQA_PLAYWRIGHT_TRACE: off | on | retain-on-failure | on-first-retry (Playwright testOptions.trace)
AUTOQA_PLAYWRIGHT_TRACE=off
# 1/true = headed Chromium in container (often impractical on Docker Desktop for Windows without extra display setup)
AUTOQA_PLAYWRIGHT_HEADED=0
AUTOQA_PLAYWRIGHT_SLOWMO_MS=0
# Full origin for wait-on + Playwright baseURL inside the sandbox (overrides vite/next port heuristics).
# Example: http://localhost:4173
AUTOQA_E2E_BASE_URL=
# Optional Playwright runner tuning (forwarded into the sandbox container)
AUTOQA_PLAYWRIGHT_TEST_TIMEOUT_MS=
AUTOQA_PLAYWRIGHT_EXPECT_TIMEOUT_MS=
AUTOQA_PLAYWRIGHT_ACTION_TIMEOUT_MS=
AUTOQA_PLAYWRIGHT_RETRIES=

# Live browser streaming (noVNC in Docker)
# When true, Playwright runs headed inside the container with Xvfb + noVNC.
# The dashboard shows a live browser viewer panel for real-time test observation.
# Installs VNC stack (xvfb, x11vnc, novnc, websockify) at container startup.
AUTOQA_LIVE_BROWSER=true
# Base port for noVNC WebSocket connections (container 1 = this port, container 2 = +1, etc.)
AUTOQA_VNC_BASE_PORT=6080
# SlowMo in ms when live browser is enabled (makes tests watchable). Set to 0 for full speed.
AUTOQA_LIVE_SLOWMO_MS=300

# Video recording: on | off | retain-on-failure | on-first-retry
# When enabled, Playwright saves .webm recordings of every test for post-hoc review in the dashboard.
AUTOQA_PLAYWRIGHT_VIDEO=on
