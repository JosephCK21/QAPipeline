# Existing backend settings
PORT=3001
GITHUB_TOKEN=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Reasoning effort tiers per call purpose (low | medium | high)
OPENAI_SCENARIO_EFFORT=low
OPENAI_TESTCASE_EFFORT=medium
OPENAI_HEAL_EFFORT=high
# Stateful chain mechanism:
#   conversation (default) — Conversations API, no TTL, one conversation per test case
#   chain                  — previous_response_id chaining (items expire in 30 days)
#   zdr                    — no server-side storage; reasoning passed as encrypted_content each turn
OPENAI_STATEFUL_MODE=conversation
# Reasoning summary verbosity: auto | concise | detailed | none
OPENAI_REASONING_SUMMARY=auto
# Reasoning effort for the lightweight PR bug-fix classifier (none|low|medium|high|xhigh)
# "low" is the fastest universally-supported setting across gpt-5.x models and
# typically cuts end-to-end latency by 2-5x vs "low".
OPENAI_CLASSIFIER_EFFORT=low
# Output verbosity hint for structured-output calls (low|medium|high). "low"
# trims ambient prose around JSON payloads; safe for all our strict-schema calls.
OPENAI_OUTPUT_VERBOSITY=low
# Prompt cache retention policy. "24h" keeps cached prefixes alive up to 24 hours
# (on gpt-5.x / gpt-5.x-mini), dramatically improving hit rate for long-running
# pipelines that span hours. Set to "in_memory" for the default 5-10 minute policy.
OPENAI_PROMPT_CACHE_RETENTION=24h

# Bug-fix regression mode
# When REGRESSION_ENABLED=true (default) the pipeline runs a bug-fix classifier
# on every PR. If the PR is classified as a bug fix (LLM verdict above the
# confidence threshold OR a linked Jira issue with issueType=Bug), the pipeline
# skips new test-case generation and instead re-runs every existing latest
# test case for every scenario under every epic the PR touches. Failures are
# still healed but any heal marks the test case as "adapted" so the original
# failure is retained as a potential regression signal.
REGRESSION_ENABLED=true
REGRESSION_BUGFIX_CONFIDENCE_THRESHOLD=0.6

# Jira integration settings (Part 1)
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_USER_EMAIL=your@email.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_PROJECT_KEY=TEST
JIRA_TRIGGER_STATUS=Selected For Development
JIRA_WEBHOOK_SECRET=your_jira_webhook_secret_token_here
# Per-command cap for git clone, docker ops, npm install (extra deps), and npx jest inside the sandbox.
# Values like 30000 often kill Jest mid-run in Docker; 120000+ is safer.
SANDBOX_TIMEOUT_MS=120000

# Playwright E2E in Docker: failure screenshots copied to the AutoQA UI per test case.
# AUTOQA_PLAYWRIGHT_TRACE: off | on | retain-on-failure | on-first-retry (Playwright testOptions.trace)
AUTOQA_PLAYWRIGHT_TRACE=off
# 1/true = headed Chromium in container (often impractical on Docker Desktop for Windows without extra display setup)
AUTOQA_PLAYWRIGHT_HEADED=0
AUTOQA_PLAYWRIGHT_SLOWMO_MS=0
# 1 = also write HTML report under test-results/playwright-html in the sandbox checkout
AUTOQA_PLAYWRIGHT_HTML_REPORT=0
