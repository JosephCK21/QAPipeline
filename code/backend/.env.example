# Existing backend settings
PORT=3001
GITHUB_TOKEN=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Reasoning effort tiers per call purpose (low | medium | high)
OPENAI_SCENARIO_EFFORT=low
OPENAI_TESTCASE_EFFORT=medium
OPENAI_HEAL_EFFORT=high
# Stateful chain mechanism:
#   conversation (default) — Conversations API, no TTL, one conversation per test case
#   chain                  — previous_response_id chaining (items expire in 30 days)
#   zdr                    — no server-side storage; reasoning passed as encrypted_content each turn
OPENAI_STATEFUL_MODE=conversation
# Reasoning summary verbosity: auto | concise | detailed | none
OPENAI_REASONING_SUMMARY=auto

# Bug-fix regression mode
# When REGRESSION_ENABLED=true (default) the pipeline runs a bug-fix classifier
# on every PR. If the PR is classified as a bug fix (LLM verdict above the
# confidence threshold OR a linked Jira issue with issueType=Bug), the pipeline
# skips new test-case generation and instead re-runs every existing latest
# test case for every scenario under every epic the PR touches. Failures are
# still healed but any heal marks the test case as "adapted" so the original
# failure is retained as a potential regression signal.
REGRESSION_ENABLED=true
REGRESSION_BUGFIX_CONFIDENCE_THRESHOLD=0.6

# Jira integration settings (Part 1)
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_USER_EMAIL=your@email.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_PROJECT_KEY=TEST
JIRA_TRIGGER_STATUS=Selected For Development
JIRA_WEBHOOK_SECRET=your_jira_webhook_secret_token_here
SANDBOX_TIMEOUT_MS=30000
